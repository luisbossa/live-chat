# ==========================================================================
# Yabla · variables de entorno
# Copia este archivo como .env para desarrollo local.
# En producción (Vercel) defínelas en Settings → Environment Variables.
# ==========================================================================

# development | production
# En producción activa cookies seguras (HTTPS) y exige SESSION_SECRET.
NODE_ENV=development

# Puerto HTTP (solo en local; en Vercel no se usa).
PORT=3000

# Clave para firmar la cookie de sesión. OBLIGATORIA en producción (mínimo 32 caracteres).
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si ya tenías una en Render, usa la misma en Vercel para no cerrar las sesiones abiertas.
SESSION_SECRET=

# Base de datos.
# - Vacío: se usa un archivo SQLite local (DATABASE_PATH). Ideal para desarrollar.
# - Producción gratuita: Turso (SQLite en la nube). Copia la URL y un token desde turso.tech.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_PATH=./data/yabla.db

# URL pública (código QR de perfil). Opcional en Vercel: se detecta sola.
# Defínela si usas un dominio propio, p. ej. https://chat.tudominio.com
BASE_URL=http://localhost:3000

# true = crea los usuarios demo (contraseña demo1234) si la base de datos está vacía.
SEED_DEMO=true

# Notificaciones push (Web Push). Opcionales: si faltan, Yabla genera un par de claves
# la primera vez y lo guarda en la base de datos. Para fijarlas: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del emisor de las notificaciones (mailto: o https:)
VAPID_SUBJECT=mailto:hola@yabla.app

# Tiempo real con Pusher Channels (pusher.com → Channels → App Keys).
# Activa "Enable client events" en App Settings y añade el webhook
# https://tu-app.vercel.app/api/realtime/webhook con "Channel existence" y "Presence".
# Sin estas claves la app funciona, pero sin eventos en vivo ni llamadas.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=us2

# Vercel Blob (archivos subidos). Vercel la añade sola al conectar un Blob store al proyecto.
# Vacía: los archivos se guardan en la base de datos (desarrollo local).
BLOB_READ_WRITE_TOKEN=

# Clave para GET /api/cron/tick (mensajes programados, temporales, estados caducados…).
# El cron externo (cron-job.org, cada minuto) envía: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Servidores ICE para WebRTC (JSON). Para llamadas entre redes distintas añade un TURN:
# [{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.tudominio.com:3478","username":"usuario","credential":"clave"}]
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]
