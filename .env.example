# Puerto del servidor
PORT=3000

# Clave para firmar la cookie de sesión. Cámbiala en producción.
SESSION_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Ruta de la base de datos SQLite y de los archivos subidos
DATABASE_PATH=./data/yabla.db
UPLOADS_DIR=./data/uploads

# URL pública (se usa en el código QR de perfil)
BASE_URL=http://localhost:3000

# Servidores ICE para WebRTC (JSON). Añade un servidor TURN para llamadas entre redes distintas.
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]
