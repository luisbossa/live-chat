<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="description" content="Yabla: chatea y haz videollamadas con tus amigos en tiempo real">
    <title><%= locals.title ? `${title} - ${appName}` : appName %></title>
    <link rel="icon" href="/assets/images/ui/favicon.png" type="image/png">
    <!-- App instalable (PWA): icono, colores y modo pantalla completa en móviles -->
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#f7f7f7" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#161616" media="(prefers-color-scheme: dark)">
    <meta name="application-name" content="Yabla">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Yabla">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <link rel="apple-touch-icon" href="/assets/images/pwa/apple-touch-icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">

    <link rel="stylesheet" href="/assets/css/base.css">
    <% (locals.styles || []).forEach((name) => { %>
    <link rel="stylesheet" href="/assets/css/<%= name %>.css">
    <% }) %>
    <script src="/assets/js/common.js"></script>
</head>

<body class="<%= locals.bodyClass || '' %>">
    <div class="mist" aria-hidden="true"></div>

    <%- body %>

    <%- defineContent('scripts') %>
</body>

</html>
