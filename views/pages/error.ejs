<main class="auth">
    <section class="auth-card auth-card-sm">
        <div class="auth-form">
            <div class="auth-step is-active error-page">
                <span class="logo logo-lg"><%- icon('logo') %></span>
                <p class="error-code"><%= status %></p>
                <h1 class="title"><%= title %></h1>
                <p class="subtitle"><%= message %></p>
                <a class="btn btn-primary btn-block" href="/">Volver al inicio</a>
            </div>
        </div>
    </section>
</main>
