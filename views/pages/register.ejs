<main class="auth auth-register">
    <section class="auth-card">
        <div class="auth-form">
            <header class="auth-top">
                <a href="/" class="icon-btn" aria-label="Volver al inicio"><%- icon('arrow-left') %></a>
                <a href="/login" class="auth-switch">¿Ya tienes cuenta? <strong>Entrar</strong></a>
                <button class="icon-btn" type="button" data-theme-toggle aria-label="Cambiar tema"><%- icon('moon') %></button>
            </header>

            <form id="registerForm" class="register" novalidate>
                <div class="register-head">
                    <span class="logo logo-lg"><%- icon('logo') %></span>
                    <h1 class="title">Crea tu cuenta</h1>
                    <p class="subtitle">Solo un nombre, un usuario y una contraseña. Sin correo ni códigos.</p>
                </div>

                <!-- Foto (opcional) -->
                <div class="register-photo">
                    <div class="avatar-upload">
                        <div class="avatar-edit">
                            <input type="file" id="avatarInput" name="avatar" accept="image/png, image/jpeg, image/webp, image/gif">
                            <label for="avatarInput" aria-label="Elegir foto"><%- icon('camera', 'icon-sm') %></label>
                        </div>
                        <div class="avatar-preview">
                            <div style="background-image: url(/assets/images/ui/avatar-default.svg);"></div>
                        </div>
                    </div>
                    <div>
                        <strong>Foto de perfil</strong>
                        <small>Opcional. Toca la cámara para elegir una.</small>
                    </div>
                </div>

                <div class="field">
                    <label for="name" class="label">¿Cómo te llamas?</label>
                    <div class="input-icon">
                        <%- icon('user', 'icon-sm') %>
                        <input type="text" id="name" name="name" class="input" placeholder="Nombre y apellido" autocomplete="name" maxlength="60" required>
                    </div>
                    <span class="field-error" data-error-for="name"></span>
                </div>

                <div class="field">
                    <label for="username" class="label">Nombre de usuario</label>
                    <div class="input-prefix username-field">
                        <span>@</span>
                        <input type="text" id="username" name="username" class="input" placeholder="tu_usuario"
                            autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="20" required>
                        <span class="username-status" id="usernameStatus" aria-live="polite"></span>
                    </div>
                    <span class="field-hint" id="usernameHint">Con él entrarás y te encontrarán tus amigos.</span>
                    <div class="username-ideas" id="usernameIdeas" hidden></div>
                    <span class="field-error" data-error-for="username"></span>
                </div>

                <div class="field">
                    <label for="password" class="label">Contraseña</label>
                    <div class="input-group">
                        <input type="password" id="password" name="password" class="input" placeholder="Mínimo 6 caracteres"
                            autocomplete="new-password" minlength="6" required>
                        <button type="button" class="icon-btn toggle-password" data-target="password" aria-label="Mostrar contraseña"><%- icon('eye') %></button>
                    </div>
                    <div class="strength" id="strength" data-level="0" aria-hidden="true"><i></i><i></i><i></i></div>
                    <span class="field-hint" id="strengthLabel">Usa al menos 6 caracteres.</span>
                    <span class="field-error" data-error-for="password"></span>
                </div>

                <p class="form-alert" id="formAlert" role="alert" hidden></p>
                <button type="submit" class="btn btn-brand btn-block register-submit" id="submitBtn">
                    <span class="spinner" aria-hidden="true"></span><span class="label-text">Crear cuenta</span><%- icon('arrow-up-right', 'icon-sm') %>
                </button>

                <ul class="register-perks">
                    <li><%- icon('zap', 'icon-sm') %>En 30 segundos</li>
                    <li><%- icon('lock', 'icon-sm') %>Sin correo</li>
                    <li><%- icon('gift', 'icon-sm') %>Gratis</li>
                </ul>
            </form>
        </div>

        <!-- Vista previa: así te verán tus amigos (se actualiza al escribir) -->
        <aside class="auth-showcase register-showcase" aria-hidden="true">
            <div class="showcase-copy">
                <span class="showcase-tag"><%- icon('sparkles', 'icon-sm') %> Vista previa</span>
                <h2>Así te verán tus amigos</h2>
            </div>

            <div class="preview-phone">
                <div class="preview-profile">
                    <img id="previewAvatar" src="/assets/images/ui/avatar-default.svg" alt="">
                    <div>
                        <strong id="previewName">Tu nombre</strong>
                        <small id="previewUser">@tu_usuario</small>
                    </div>
                    <span class="preview-online">en línea</span>
                </div>
                <div class="preview-chat">
                    <div class="sc-bubble in"><b>Karla</b>¡Hola, <span id="previewFirst">amigo</span>! Bienvenido a Yabla 👋</div>
                    <div class="sc-bubble out">¡Gracias! Ya estoy aquí 😄</div>
                    <div class="sc-bubble in"><b>Mauricio</b>¿Mejenga el viernes? ⚽</div>
                    <img class="sc-sticker" src="/assets/images/stickers/sticker5.gif" alt="">
                    <div class="sc-typing"><span></span><span></span><span></span></div>
                </div>
            </div>

            <ul class="showcase-features">
                <li><span><%- icon('chat') %></span>Chats y grupos en tiempo real</li>
                <li><span><%- icon('video') %></span>Llamadas y videollamadas</li>
                <li><span><%- icon('status') %></span>Estados que duran 24 h</li>
            </ul>
        </aside>
    </section>
</main>

<%- contentFor('scripts') %>
<script src="/assets/js/auth-ui.js"></script>
<script src="/assets/js/image-upload.js"></script>
<script src="/assets/js/register.js"></script>
