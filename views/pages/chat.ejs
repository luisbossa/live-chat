<div class="app" id="app">
    <%- include('../partials/chat/rail') %>
    <%- include('../partials/chat/sidebar') %>
    <%- include('../partials/chat/conversation') %>
    <%- include('../partials/chat/info') %>
    <div class="scrim" data-action="toggle-info"></div>
</div>

<%- include('../partials/chat/story-viewer') %>
<%- include('../partials/chat/calls') %>
<%- include('../partials/chat/modals') %>

<!-- Menú contextual de mensajes -->
<div class="msg-menu" id="msgMenu" role="menu" hidden>
    <div class="msg-menu-reactions" id="msgMenuReactions"></div>
    <button role="menuitem" data-msg-action="reply"><%- icon('reply') %>Responder</button>
    <button role="menuitem" data-msg-action="forward"><%- icon('forward') %>Reenviar</button>
    <button role="menuitem" data-msg-action="copy"><%- icon('copy') %>Copiar</button>
    <button role="menuitem" data-msg-action="star"><%- icon('star') %><span>Destacar</span></button>
    <button role="menuitem" data-msg-action="pin"><%- icon('pin') %><span>Fijar</span></button>
    <button role="menuitem" data-msg-action="edit"><%- icon('edit') %>Editar</button>
    <button role="menuitem" data-msg-action="info"><%- icon('message-info') %>Info.</button>
    <button role="menuitem" data-msg-action="select"><%- icon('check-circle') %>Seleccionar</button>
    <hr>
    <button role="menuitem" data-msg-action="delete" class="is-danger"><%- icon('trash') %>Eliminar</button>
</div>

<!-- Reacción rápida al pasar el ratón -->
<div class="react-tray" id="reactTray" role="menu" hidden></div>
<!-- Selector completo para reaccionar con cualquier emoji -->
<div class="popover emoji-panel react-picker" id="reactPicker" hidden></div>

<!-- Menú contextual de chats (lista) -->
<div class="msg-menu conv-menu" id="convMenu" role="menu" hidden>
    <button role="menuitem" data-conv-action="pin"><%- icon('pin') %><span>Fijar chat</span></button>
    <button role="menuitem" data-conv-action="mute"><svg class="icon" aria-hidden="true"><use href="/assets/images/icons.svg#i-bell-off"></use></svg><span>Silenciar</span></button>
    <button role="menuitem" data-conv-action="archive"><%- icon('archive') %><span>Archivar chat</span></button>
    <button role="menuitem" data-conv-action="read"><%- icon('check-check') %><span>Marcar como leído</span></button>
    <button role="menuitem" data-conv-action="clear"><%- icon('x') %><span>Vaciar chat</span></button>
    <hr>
    <button role="menuitem" data-conv-action="delete" class="is-danger"><%- icon('trash') %><span>Eliminar chat</span></button>
</div>

<script type="application/json" id="clientConfig"><%- json(clientConfig) %></script>

<%- contentFor('scripts') %>
<script src="/socket.io/socket.io.js"></script>
<script type="module" src="/assets/js/chat/main.js"></script>
