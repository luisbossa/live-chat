<!-- Barra de navegación: lateral en escritorio, inferior en móvil -->
<nav class="rail" aria-label="Navegación principal">
    <a href="/chat" class="logo rail-logo" aria-label="Yabla"><%- icon('logo') %></a>

    <div class="rail-tabs" role="tablist">
        <button class="rail-btn is-active" role="tab" data-tab="chats" aria-selected="true">
            <%- icon('chat') %><span>Chats</span><b class="badge" data-badge="chats" hidden></b>
        </button>
        <button class="rail-btn" role="tab" data-tab="groups" aria-selected="false">
            <%- icon('users') %><span>Grupos</span><b class="badge" data-badge="groups" hidden></b>
        </button>
        <button class="rail-btn" role="tab" data-tab="discover" aria-selected="false">
            <%- icon('flame') %><span>Conocer</span><b class="badge badge-dot is-love" data-badge="discover" hidden></b>
        </button>
        <button class="rail-btn" role="tab" data-tab="status" aria-selected="false">
            <%- icon('status') %><span>Estados</span><b class="badge badge-dot" data-badge="status" hidden></b>
        </button>
    </div>

    <div class="rail-bottom">
        <div class="dropdown rail-theme">
            <button class="rail-btn" data-dropdown aria-label="Elegir tema" aria-haspopup="true" aria-expanded="false" title="Tema">
                <%- icon('palette') %><span>Tema</span>
            </button>
            <div class="menu theme-menu" role="menu" aria-label="Tema">
                <p class="theme-menu-title">Tema</p>
                <div class="theme-grid" id="themeMenu" role="radiogroup" aria-label="Tema"></div>
                <hr>
                <button role="menuitem" data-open="modal-settings"><%- icon('settings') %>Más opciones de apariencia</button>
            </div>
        </div>
        <button class="rail-btn rail-logout" data-open="modal-logout" aria-label="Cerrar sesión" title="Cerrar sesión">
            <%- icon('logout') %><span>Salir</span>
        </button>
        <button class="rail-btn rail-me" data-open="modal-profile" aria-label="Mi perfil">
            <span class="rail-me-pic"><img src="<%= user.avatar %>" alt="" data-me="avatar"><i class="status-dot" data-me-status></i></span><span>Perfil</span>
        </button>
    </div>
</nav>
