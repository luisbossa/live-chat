<!-- Conversación activa -->
<main class="chat" id="chat">
    <!-- Inicio: se muestra cuando no hay ningún chat abierto -->
    <div class="chat-empty home" id="chatEmpty">
        <div class="home-inner">
            <!-- Portada con saludo, resumen y accesos -->
            <header class="home-hero" id="homeHero">
                <div class="home-hero-bg" aria-hidden="true"><i></i><i></i><i></i></div>
                <button class="home-avatar-btn" data-open="modal-profile" aria-label="Mi perfil">
                    <img class="home-avatar" src="<%= user.avatar %>" alt="" data-me="avatar">
                    <i class="status-dot" data-me-status></i>
                    <span class="home-avatar-hint" id="homeAvatarHint" hidden><%- icon('camera', 'icon-sm') %></span>
                </button>
                <div class="home-hero-text">
                    <p class="home-date"><span id="homeDayIcon"></span><span id="homeDate"></span></p>
                    <h2><span id="homeGreeting">Hola</span>, <span data-me="firstName"><%= user.name.split(' ')[0] %></span> <%- icon('hand', 'greet-icon') %></h2>
                    <p class="home-summary" id="homeSummary">Elige una conversación o empieza una nueva.</p>
                    <div class="home-pills" id="homePills"></div>
                </div>
                <!-- Ilustración: mini conversación flotante -->
                <div class="home-art" aria-hidden="true">
                    <span class="art-bubble art-in">¡Hola! 👋</span>
                    <span class="art-bubble art-out">¿Mejenga hoy? ⚽</span>
                    <span class="art-bubble art-in art-typing"><i></i><i></i><i></i></span>
                </div>
            </header>

            <div class="home-actions">
                <button data-open="modal-new-chat"><span class="tone-blue"><%- icon('chat-plus') %></span><strong>Nuevo chat</strong><small>Escribe a cualquier persona</small><kbd>Ctrl Alt N</kbd></button>
                <button data-open="modal-group"><span class="tone-violet"><%- icon('users') %></span><strong>Nuevo grupo</strong><small>Reúne a tus amigos</small></button>
                <button data-action="my-status"><span class="tone-pink"><%- icon('camera') %></span><strong>Publicar estado</strong><small>Desaparece en 24 h</small></button>
                <button data-open="modal-quick"><span class="tone-green"><%- icon('search') %></span><strong>Buscar</strong><small>Chats, acciones y más</small><kbd>Ctrl K</kbd></button>
            </div>

            <section class="home-card" id="homeChecklist" hidden></section>

            <div class="home-grid">
                <!-- Chats recientes -->
                <section class="home-card" id="homeRecentCard" hidden>
                    <div class="home-card-head">
                        <h3><%- icon('chat', 'icon-sm') %> Continúa la conversación</h3>
                    </div>
                    <ul class="home-recent" id="homeRecent"></ul>
                </section>

                <!-- Consejo del día -->
                <section class="home-card home-tip" id="homeTip">
                    <div class="home-card-head">
                        <h3><%- icon('sparkles', 'icon-sm') %> ¿Sabías que…?</h3>
                        <button class="link-btn" data-action="next-tip">Otro consejo</button>
                    </div>
                    <div class="tip-body" id="tipBody"></div>
                </section>
            </div>

            <section class="home-card" id="homePeopleCard" hidden>
                <div class="home-card-head">
                    <h3><%- icon('user-plus', 'icon-sm') %> Personas que quizá conozcas</h3>
                    <button class="link-btn" data-open="modal-new-chat">Ver todas</button>
                </div>
                <div class="people-grid" id="homePeople"></div>
            </section>
        </div>
    </div>

    <!-- Conocer: pila de tarjetas para deslizar (pestaña «Conocer» sin chat abierto) -->
    <section class="discover" id="discover" aria-label="Conocer gente" hidden>
        <header class="dz-head">
            <button class="icon-btn dz-back" data-action="dz-back" aria-label="Ver mis matches"><%- icon('arrow-left') %></button>
            <div>
                <h2><%- icon('flame') %> Conocer</h2>
                <p class="muted" id="dzHint">Desliza a la derecha si te gusta, a la izquierda para pasar.</p>
            </div>
            <div class="dz-head-actions">
                <span class="dz-super-left" id="dzSuperLeft" title="Súper likes de hoy"><%- icon('star-fill', 'icon-sm') %><b>3</b></span>
                <button class="icon-btn" data-open="modal-dating-filters" aria-label="Filtros" title="Filtros"><%- icon('sliders') %></button>
            </div>
        </header>
        <div class="dz-stage">
            <div class="dz-deck" id="dzDeck" aria-live="polite"></div>
            <div class="dz-empty" id="dzEmpty" hidden></div>
        </div>
        <div class="dz-actions" id="dzActions">
            <button class="dz-btn is-undo" data-swipe="undo" aria-label="Deshacer" title="Deshacer (Ctrl+Z)"><%- icon('rotate-ccw') %></button>
            <button class="dz-btn is-pass" data-swipe="pass" aria-label="Paso" title="Paso (←)"><%- icon('x') %></button>
            <button class="dz-btn is-super" data-swipe="superlike" aria-label="Súper like" title="Súper like (↑)"><%- icon('star-fill') %></button>
            <button class="dz-btn is-like" data-swipe="like" aria-label="Me gusta" title="Me gusta (→)"><%- icon('heart-fill') %></button>
        </div>
    </section>

    <header class="chat-head">
        <button class="icon-btn back-btn" data-action="close-chat" aria-label="Volver"><%- icon('arrow-left') %></button>
        <button class="chat-peer" data-action="toggle-info">
            <span class="avatar" id="peerAvatar"><img src="" alt=""></span>
            <span>
                <strong><span id="peerName"></span><span class="peer-timer" id="peerTimer" hidden title="Mensajes temporales activados"><%- icon('timer', 'icon-sm') %></span></strong>
                <small id="peerStatus"></small>
            </span>
        </button>
        <div class="head-actions">
            <button class="icon-btn" data-call="audio" aria-label="Llamada de voz" title="Llamada de voz"><%- icon('phone') %></button>
            <button class="icon-btn" data-call="video" aria-label="Videollamada" title="Videollamada"><%- icon('video') %></button>
            <button class="icon-btn" data-action="search-chat" aria-label="Buscar en el chat" title="Buscar"><%- icon('search') %></button>
            <button class="icon-btn" data-action="toggle-info" aria-label="Información" title="Información"><%- icon('info') %></button>
        </div>
    </header>

    <!-- Selección de varios mensajes -->
    <div class="select-bar" id="selectBar" hidden>
        <button class="icon-btn" data-action="cancel-select" aria-label="Cancelar selección"><%- icon('x') %></button>
        <strong id="selectCount">0 seleccionados</strong>
        <div class="head-actions">
            <button class="icon-btn" data-select-action="copy" aria-label="Copiar" title="Copiar"><%- icon('copy') %></button>
            <button class="icon-btn" data-select-action="star" aria-label="Destacar" title="Destacar"><%- icon('star') %></button>
            <button class="icon-btn" data-select-action="forward" aria-label="Reenviar" title="Reenviar"><%- icon('forward') %></button>
            <button class="icon-btn is-danger" data-select-action="delete" aria-label="Eliminar" title="Eliminar"><%- icon('trash') %></button>
        </div>
    </div>

    <!-- Mensajes fijados (se recorren al tocar, como en Telegram) -->
    <div class="pinned-bar" id="pinnedBar" hidden>
        <span class="pinned-marks" id="pinnedMarks"></span>
        <button class="pinned-main" id="pinnedMain">
            <span class="pinned-thumb" id="pinnedThumb"></span>
            <span class="pinned-text"><strong id="pinnedTitle">Mensaje fijado</strong><span id="pinnedPreview"></span></span>
        </button>
        <button class="icon-btn" id="pinnedUnpin" aria-label="Desfijar" title="Desfijar"><%- icon('pin-off', 'icon-sm') %></button>
    </div>

    <div class="chat-search" id="chatSearch" hidden>
        <%- icon('search', 'icon-sm') %>
        <input type="search" id="chatSearchInput" placeholder="Buscar en la conversación…">
        <span class="muted" id="chatSearchCount"></span>
        <button class="icon-btn" data-action="search-chat" aria-label="Cerrar búsqueda"><%- icon('x', 'icon-sm') %></button>
    </div>

    <div class="messages" id="messages" aria-live="polite"></div>
    <button class="scroll-down" id="scrollDown" aria-label="Ir al último mensaje" hidden><%- icon('chevron-down') %><b class="badge" hidden></b></button>

    <footer class="composer" id="composer">
        <div class="blocked-note" id="blockedNote" hidden>
            Bloqueaste a este contacto. <button data-action="block">Desbloquear</button>
        </div>

        <!-- Respondiendo / editando -->
        <div class="compose-context" id="composeContext" hidden>
            <span class="compose-context-icon"></span>
            <div>
                <strong id="composeContextTitle"></strong>
                <p id="composeContextText"></p>
            </div>
            <button class="icon-btn" data-action="cancel-context" aria-label="Cancelar"><%- icon('x', 'icon-sm') %></button>
        </div>

        <!-- Programados pendientes en este chat -->
        <button class="scheduled-chip" id="scheduledChip" data-open="modal-scheduled" hidden><%- icon('calendar-clock', 'icon-sm') %><span id="scheduledChipText"></span></button>

        <!-- Sugerencias de @menciones (grupos) -->
        <div class="mention-box" id="mentionBox" role="listbox" hidden></div>

        <!-- Paneles emergentes -->
        <div class="popover emoji-panel" id="emojiPanel" hidden></div>
        <div class="popover sticker-panel" id="stickerPanel" hidden></div>
        <div class="popover attach-menu" id="attachMenu" hidden>
            <button data-attach="image"><span class="tone-blue"><%- icon('image') %></span>Foto o video</button>
            <button data-attach="camera"><span class="tone-pink"><%- icon('camera') %></span>Cámara</button>
            <button data-attach="video"><span class="tone-orange"><%- icon('video') %></span>Grabar video</button>
            <button data-attach="file"><span class="tone-violet"><%- icon('file') %></span>Documento</button>
            <button data-attach="payment"><span class="tone-green"><%- icon('wallet') %></span>Enviar dinero</button>
            <button data-attach="schedule"><span class="tone-orange"><%- icon('calendar-clock') %></span>Programar mensaje</button>
            <button data-attach="this-or-that" class="for-match"><span class="tone-pink"><%- icon('dice') %></span>Esto o aquello</button>
            <button data-attach="date" class="for-match"><span class="tone-violet"><%- icon('calendar-heart') %></span>Proponer una cita</button>
        </div>

        <!-- Grabando nota de voz -->
        <div class="recorder" id="recorder" hidden>
            <button class="icon-btn" data-action="cancel-recording" aria-label="Descartar"><%- icon('trash') %></button>
            <span class="rec-dot"></span>
            <span class="rec-time" id="recTime">0:00</span>
            <span class="rec-wave" id="recWave"></span>
            <button class="send-btn" data-action="send-recording" aria-label="Enviar nota de voz"><%- icon('send') %></button>
        </div>

        <form class="composer-bar" id="composerForm">
            <button type="button" class="icon-btn" data-popover="emojiPanel" aria-label="Emojis"><%- icon('smile') %></button>
            <button type="button" class="icon-btn" data-popover="attachMenu" aria-label="Adjuntar"><%- icon('paperclip') %></button>
            <textarea id="messageInput" rows="1" placeholder="Escribe un mensaje…" aria-label="Mensaje" maxlength="4000"></textarea>
            <button type="button" class="icon-btn" data-popover="stickerPanel" aria-label="Stickers"><%- icon('sticker') %></button>
            <button type="button" class="send-btn is-mic" id="micBtn" data-action="start-recording" aria-label="Grabar nota de voz"><%- icon('mic') %></button>
            <button type="submit" class="send-btn" id="sendBtn" aria-label="Enviar" hidden><%- icon('send') %></button>
        </form>
        <input type="file" id="fileInput" hidden>
    </footer>
</main>
