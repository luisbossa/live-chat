<!-- Lista de conversaciones y estados -->
<aside class="sidebar" aria-label="Conversaciones">
    <header class="sidebar-head">
        <div>
            <p class="muted greeting">Hola, <span data-me="firstName"><%= user.name.split(' ')[0] %></span> <%- icon('hand', 'greet-icon') %></p>
            <h1 id="sidebarTitle">Chats</h1>
        </div>
        <div class="head-actions">
            <button class="icon-btn" data-open="modal-new-chat" aria-label="Nuevo chat" title="Nuevo chat"><%- icon('chat-plus') %></button>
            <div class="dropdown">
                <button class="icon-btn" data-dropdown aria-label="Más opciones" aria-expanded="false"><%- icon('more') %></button>
                <div class="menu" role="menu">
                    <button role="menuitem" data-open="modal-group"><%- icon('users') %>Nuevo grupo</button>
                    <button role="menuitem" data-open="modal-starred"><%- icon('star') %>Mensajes destacados</button>
                    <button role="menuitem" data-action="open-archived"><%- icon('archive') %>Chats archivados</button>
                    <button role="menuitem" data-open="modal-qr"><%- icon('qr') %>Mi código QR</button>
                    <button role="menuitem" data-open="modal-wallet"><%- icon('wallet') %>Billetera</button>
                    <button role="menuitem" data-open="modal-settings"><%- icon('settings') %>Ajustes</button>
                    <button role="menuitem" data-open="modal-shortcuts" data-kbd-only><%- icon('keyboard') %>Atajos de teclado</button>
                    <hr>
                    <button role="menuitem" class="is-danger" data-open="modal-logout"><%- icon('logout') %>Cerrar sesión</button>
                </div>
            </div>
        </div>
    </header>

    <label class="search">
        <%- icon('search', 'icon-sm') %>
        <input type="search" id="listSearch" placeholder="Buscar chats…" autocomplete="off">
        <kbd class="search-kbd" data-open="modal-quick" title="Buscador rápido">Ctrl K</kbd>
    </label>

    <div class="panel is-active" data-panel="chats">
        <div class="stories-strip" id="storiesStrip"></div>
        <!-- Filtros rápidos, como en WhatsApp -->
        <div class="chips" id="chatFilters" role="tablist" aria-label="Filtrar chats">
            <button class="chip is-active" role="tab" data-filter="all">Todos</button>
            <button class="chip" role="tab" data-filter="unread">No leídos<b data-filter-count="unread" hidden></b></button>
            <button class="chip" role="tab" data-filter="groups">Grupos</button>
            <button class="chip" role="tab" data-filter="pinned">Fijados</button>
        </div>
        <!-- Primeros pasos (solo en móvil; en escritorio está en la pantalla de inicio) -->
        <section class="side-checklist" id="sideChecklist" hidden></section>
        <ul class="conv-list" id="chatList"></ul>
        <!-- Sugerencias cuando aún tienes pocos contactos -->
        <section class="side-people" id="sidePeople" hidden>
            <h3 class="list-title">Personas que quizá conozcas</h3>
            <ul class="conv-list" id="sidePeopleList"></ul>
        </section>
    </div>

    <div class="panel" data-panel="groups">
        <button class="new-item" data-open="modal-group">
            <span><%- icon('plus') %></span>Crear un grupo nuevo
        </button>
        <ul class="conv-list" id="groupList"></ul>
    </div>

    <!-- Conocer: tu perfil de citas, quién te dio like y tus matches -->
    <div class="panel" data-panel="discover">
        <button class="dz-me" data-open="modal-dating" id="dzMe">
            <span class="dz-me-pic"><img src="<%= user.avatar %>" alt="" id="dzMePhoto"></span>
            <span class="dz-me-text"><strong id="dzMeTitle">Crea tu perfil de citas</strong><small id="dzMeSub">Solo lo verán otras personas de «Conocer»</small></span>
            <%- icon('chevron-right', 'icon-sm') %>
        </button>
        <button class="btn btn-primary btn-block dz-open-deck" data-action="dz-open"><%- icon('flame', 'icon-sm') %>Descubrir personas</button>
        <div class="dz-quick">
            <button class="dz-likes" data-action="dz-likes" id="dzLikes">
                <span class="dz-likes-pics" id="dzLikesPics"></span>
                <span><strong id="dzLikesCount">0</strong><small>Les gustas</small></span>
            </button>
            <button class="dz-filter" data-open="modal-dating-filters"><%- icon('sliders') %><span>Filtros</span></button>
        </div>
        <h3 class="list-title">Nuevos matches</h3>
        <div class="dz-new" id="dzNew"></div>
        <h3 class="list-title">Mensajes</h3>
        <ul class="conv-list" id="dzChats"></ul>
        <p class="dz-safe muted"><%- icon('shield-check', 'icon-sm') %> Solo te pueden escribir tus matches. Puedes reportar o deshacer un match cuando quieras.</p>
    </div>

    <div class="panel" data-panel="status">
        <button class="my-status" data-action="my-status">
            <span class="avatar">
                <img src="<%= user.avatar %>" alt="" data-me="avatar">
                <i><%- icon('plus', 'icon-sm') %></i>
            </span>
            <span>
                <strong>Mi estado</strong>
                <small class="muted" id="myStatusHint">Toca para añadir una actualización</small>
            </span>
        </button>
        <div id="statusLists"></div>
    </div>
</aside>
