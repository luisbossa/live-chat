<%
  const head = (title) => `<div class="modal-head"><h2>${title}</h2><button class="icon-btn" data-close aria-label="Cerrar">${icon('x')}</button></div>`;
%>

<!-- Visor de imágenes -->
<div class="modal lightbox" id="modal-lightbox">
    <button class="icon-btn lightbox-close" data-close aria-label="Cerrar"><%- icon('x') %></button>
    <img src="" alt="" id="lightboxImg">
</div>

<!-- Vista previa de adjuntos antes de enviar -->
<div class="modal attach-modal" id="modal-attach">
    <div class="modal-dialog is-wide attach-dialog">
        <div class="modal-head">
            <h2 id="attachTitle">Enviar archivos</h2>
            <button class="icon-btn" data-close aria-label="Cerrar"><%- icon('x') %></button>
        </div>
        <div class="attach-stage" id="attachStage"></div>
        <div class="attach-strip" id="attachStrip"></div>
        <form class="attach-compose" id="attachForm">
            <input class="input" id="attachCaption" placeholder="Añade un comentario…" maxlength="1000" autocomplete="off">
            <button class="send-btn" type="submit" aria-label="Enviar"><%- icon('send') %><b class="attach-count" id="attachCount"></b></button>
        </form>
    </div>
</div>

<!-- Perfil -->
<div class="modal" id="modal-profile">
    <div class="modal-dialog profile-dialog">
        <!-- Portada con el color de perfil -->
        <div class="profile-cover" id="profileCover">
            <button class="icon-btn profile-close" data-close aria-label="Cerrar"><%- icon('x') %></button>
        </div>

        <form id="profileForm">
            <div class="profile-top">
                <div class="profile-photo">
                    <img id="profilePhoto" src="" alt="Tu foto de perfil">
                    <i class="status-dot" id="profileStatusDot"></i>
                    <input type="file" id="profileAvatar" name="avatar" accept="image/*" hidden>
                    <label for="profileAvatar" class="profile-photo-btn" aria-label="Cambiar foto" title="Cambiar foto"><%- icon('camera', 'icon-sm') %></label>
                </div>
                <div class="profile-id">
                    <strong id="profilePreviewName"></strong>
                    <small id="profilePreviewUser"></small>
                    <span class="status-chip" id="profilePreviewStatus"></span>
                </div>
                <button type="button" class="link-btn profile-remove" id="removePhotoBtn"><%- icon('trash', 'icon-sm') %>Quitar foto</button>
            </div>

            <ul class="profile-stats" id="profileStats"></ul>

            <!-- Disponibilidad: se guarda al instante -->
            <section class="profile-section">
                <h4>Tu estado</h4>
                <div class="status-picker" id="statusPicker" role="radiogroup" aria-label="Tu estado"></div>
            </section>

            <section class="profile-section">
                <h4>Datos del perfil</h4>
                <div class="field">
                    <label class="label" for="pfName">Nombre</label>
                    <input class="input" id="pfName" name="name" maxlength="60" required>
                </div>
                <div class="field">
                    <label class="label" for="pfUsername">Usuario</label>
                    <div class="input-prefix">
                        <span>@</span>
                        <input class="input" id="pfUsername" name="username" maxlength="20" autocapitalize="none" spellcheck="false">
                    </div>
                    <small class="field-note" id="pfUsernameNote">Con él entras y te encuentran.</small>
                </div>
                <div class="field">
                    <label class="label" for="pfBio">Info <span class="muted" id="pfBioCount">0/140</span></label>
                    <input class="input" id="pfBio" name="bio" maxlength="140" placeholder="Cuéntales algo de ti">
                    <div class="bio-presets" id="bioPresets"></div>
                </div>
                <div class="field-row">
                    <div class="field">
                        <label class="label" for="pfPhone">Teléfono</label>
                        <input class="input" id="pfPhone" name="phone" type="tel" maxlength="30" placeholder="+506 8888 8888">
                    </div>
                    <div class="field">
                        <span class="label">Cumpleaños <span class="muted">(opcional)</span></span>
                        <div class="birthday-picker">
                            <select class="input" id="pfBirthDay" aria-label="Día"></select>
                            <select class="input" id="pfBirthMonth" aria-label="Mes"></select>
                        </div>
                    </div>
                </div>
            </section>

            <section class="profile-section">
                <h4>Color del perfil <span class="muted">· portada y tu nombre en los grupos</span></h4>
                <div class="swatches" id="profileColors" role="radiogroup" aria-label="Color del perfil"></div>
            </section>

            <section class="profile-section profile-links">
                <button type="button" class="profile-link" data-action="share-profile"><span class="row-icon tone-blue"><%- icon('link') %></span><span class="row-text">Compartir mi perfil<small>Copia tu enlace para que te agreguen</small></span></button>
                <button type="button" class="profile-link" data-open="modal-qr"><span class="row-icon tone-violet"><%- icon('qr') %></span><span class="row-text">Mi código QR<small>Para escanear desde otro teléfono</small></span></button>
                <button type="button" class="profile-link" data-open="modal-password"><span class="row-icon tone-orange"><%- icon('lock') %></span><span class="row-text">Cambiar contraseña<small>Protege tu cuenta</small></span></button>
                <button type="button" class="profile-link" data-open="modal-settings"><span class="row-icon tone-green"><%- icon('palette') %></span><span class="row-text">Apariencia y privacidad<small>Tema, colores y confirmaciones</small></span></button>
            </section>

            <footer class="profile-foot">
                <span class="muted small" id="profileDirty"></span>
                <button type="button" class="btn btn-ghost" data-close>Cancelar</button>
                <button type="submit" class="btn btn-primary" id="profileSave" disabled>Guardar cambios</button>
            </footer>
        </form>
    </div>
</div>

<!-- Ajustes -->
<div class="modal" id="modal-settings">
    <div class="modal-dialog">
        <%- head('Ajustes') %>
        <div class="settings">
            <h4>General</h4>
            <label class="setting-row">
                <span><strong>Enviar con Enter</strong><small>Shift + Enter para salto de línea</small></span>
                <span class="switch"><input type="checkbox" id="enterSwitch"><span></span></span>
            </label>
            <h4>Notificaciones</h4>
            <label class="setting-row">
                <span><strong>Notificaciones en este dispositivo</strong><small id="pushStatus">Comprobando…</small></span>
                <span class="switch"><input type="checkbox" id="pushSwitch"><span></span></span>
            </label>
            <label class="setting-row" id="pushPreviewRow">
                <span><strong>Mostrar el contenido</strong><small>Quién escribe y el mensaje. Desactívalo para que solo diga «Tienes un mensaje nuevo»</small></span>
                <span class="switch"><input type="checkbox" id="pushPreviewSwitch"><span></span></span>
            </label>
            <label class="setting-row">
                <span><strong>Sonidos</strong><small>Al recibir y enviar mensajes con Yabla abierta</small></span>
                <span class="switch"><input type="checkbox" id="soundSwitch"><span></span></span>
            </label>
            <div class="setting-row setting-actions">
                <button type="button" class="btn btn-ghost btn-sm" id="pushTest" hidden><%- icon('bell-ring', 'icon-sm') %>Enviar notificación de prueba</button>
            </div>
            <div class="setting-row" id="installRow" hidden>
                <span><strong>Instalar Yabla</strong><small>Ábrela desde tu pantalla de inicio, a pantalla completa y con notificaciones</small></span>
                <button type="button" class="btn btn-primary btn-sm" id="installApp">Instalar</button>
            </div>
            <h4>Apariencia</h4>
            <div class="setting-block">
                <span><strong>Tema</strong><small>Combínalo con cualquier color de la app</small></span>
                <div class="theme-grid is-wide" id="themeOptions" role="radiogroup" aria-label="Tema"></div>
            </div>
            <div class="setting-block">
                <span><strong>Color de la app</strong><small>Botones, burbujas y detalles</small></span>
                <div class="swatches" id="accentSwatches" role="radiogroup" aria-label="Color de la app"></div>
            </div>
            <div class="setting-block">
                <span><strong>Fondo del chat</strong><small>Se aplica a todas las conversaciones</small></span>
                <div class="wallpapers" id="wallpaperOptions" role="radiogroup" aria-label="Fondo del chat"></div>
            </div>
            <div class="setting-block">
                <span><strong>Tamaño del texto</strong><small>Mensajes y lista de chats</small></span>
                <div class="segmented" id="textSizeOptions" role="radiogroup" aria-label="Tamaño del texto"></div>
            </div>
            <h4>Privacidad</h4>
            <label class="setting-row">
                <span><strong>Confirmaciones de lectura</strong><small>Si las desactivas, tampoco verás las de los demás</small></span>
                <span class="switch"><input type="checkbox" id="readSwitch" data-setting="readReceipts"><span></span></span>
            </label>
            <label class="setting-row">
                <span><strong>Última conexión</strong><small>Mostrar cuándo estuviste en línea</small></span>
                <span class="switch"><input type="checkbox" id="lastSeenSwitch" data-setting="showLastSeen"><span></span></span>
            </label>
            <button class="setting-row setting-link" data-open="modal-password">
                <span><strong>Cambiar contraseña</strong><small>Te pediremos la actual</small></span>
                <%- icon('chevron-right', 'icon-sm') %>
            </button>
            <h4>Ayuda</h4>
            <button class="setting-row setting-link" data-open="modal-shortcuts">
                <span><strong>Atajos de teclado</strong><small>Ctrl + K para ir a cualquier chat</small></span>
                <%- icon('chevron-right', 'icon-sm') %>
            </button>
        </div>
    </div>
</div>

<!-- Nuevo chat -->
<div class="modal" id="modal-new-chat">
    <div class="modal-dialog">
        <%- head('Nuevo chat') %>
        <label class="search search-modal">
            <%- icon('search', 'icon-sm') %>
            <input type="search" id="userSearch" placeholder="Buscar por nombre o @usuario" autocomplete="off">
        </label>
        <button class="new-item" data-open="modal-group"><span><%- icon('users') %></span>Nuevo grupo</button>
        <ul class="user-list" id="userResults"></ul>
    </div>
</div>

<!-- Nuevo grupo -->
<div class="modal" id="modal-group">
    <div class="modal-dialog">
        <%- head('Nuevo grupo') %>
        <form class="stack" id="groupForm">
            <div class="avatar-upload">
                <div class="avatar-edit">
                    <input type="file" id="groupAvatar" name="avatar" accept="image/*">
                    <label for="groupAvatar" aria-label="Foto del grupo"><%- icon('camera', 'icon-sm') %></label>
                </div>
                <div class="avatar-preview"><div style="background-image: url(/assets/images/ui/avatar-default.svg);"></div></div>
            </div>
            <div class="field">
                <label class="label" for="groupName">Nombre del grupo</label>
                <input class="input" id="groupName" name="name" placeholder="Ej. Viaje a la playa" maxlength="60" required>
            </div>
            <div class="field">
                <span class="label">Participantes <span class="muted" data-member-count></span></span>
                <div class="member-picker" id="groupPicker"></div>
            </div>
            <button class="btn btn-primary btn-block" type="submit">Crear grupo</button>
        </form>
    </div>
</div>

<!-- Añadir participantes -->
<div class="modal" id="modal-add-members">
    <div class="modal-dialog">
        <%- head('Añadir participantes') %>
        <form class="stack" id="addMembersForm">
            <div class="member-picker" id="addPicker"></div>
            <button class="btn btn-primary btn-block" type="submit">Añadir <span data-member-count></span></button>
        </form>
    </div>
</div>

<!-- Mi código QR -->
<div class="modal" id="modal-qr">
    <div class="modal-dialog">
        <%- head('Mi código QR') %>
        <div class="qr">
            <div class="qr-card">
                <img src="<%= user.avatar %>" alt="" class="qr-avatar" data-me="avatar">
                <strong data-me="name"><%= user.name %></strong>
                <span class="muted">@<span data-me="username"><%= user.username %></span></span>
                <img id="qrImage" src="" alt="Código QR de tu perfil">
            </div>
            <p class="muted">Tus amigos pueden escanear este código para empezar a chatear contigo.</p>
            <button class="btn btn-ghost btn-block" data-action="copy-profile-link"><%- icon('link') %>Copiar enlace</button>
        </div>
    </div>
</div>

<!-- Billetera -->
<div class="modal" id="modal-wallet">
    <div class="modal-dialog">
        <%- head('Billetera') %>
        <!-- Un saldo por moneda: tocar una tarjeta la elige para enviar -->
        <div class="wallet-cards">
            <button type="button" class="wallet-card" data-wallet-currency="USD">
                <small>Dólares</small>
                <strong data-balance="USD"></strong>
                <span>USD · Yabla Pay</span>
            </button>
            <button type="button" class="wallet-card is-crc" data-wallet-currency="CRC">
                <small>Colones</small>
                <strong data-balance="CRC"></strong>
                <span>CRC · Yabla Pay</span>
            </button>
        </div>
        <form class="wallet-send stack" id="walletForm">
            <h4 class="list-title">Enviar dinero</h4>
            <div class="field">
                <label class="label" for="walletTo">Para</label>
                <select class="input" id="walletTo" name="toUserId" required></select>
            </div>
            <div class="field">
                <span class="label">Moneda</span>
                <div class="currency-toggle" role="radiogroup" aria-label="Moneda">
                    <label><input type="radio" name="currency" value="USD" checked><span><b>$</b> Dólares</span></label>
                    <label><input type="radio" name="currency" value="CRC"><span><b>₡</b> Colones</span></label>
                </div>
            </div>
            <div class="wallet-row">
                <div class="field">
                    <label class="label" for="walletAmount">Monto</label>
                    <div class="input-prefix">
                        <span id="walletSymbol">$</span>
                        <input class="input" id="walletAmount" name="amount" type="number" min="0.01" step="0.01" placeholder="0.00" inputmode="decimal" required>
                    </div>
                </div>
                <div class="field">
                    <label class="label" for="walletNote">Concepto</label>
                    <input class="input" id="walletNote" name="note" maxlength="80" placeholder="Opcional">
                </div>
            </div>
            <p class="wallet-hint muted" id="walletHint"></p>
            <button class="btn btn-brand btn-block" type="submit"><%- icon('transfer') %><span id="walletSubmitLabel">Enviar</span></button>
        </form>
        <h4 class="list-title">Actividad reciente</h4>
        <ul class="wallet-activity" id="walletActivity"></ul>
    </div>
</div>

<!-- Nuevo estado -->
<div class="modal" id="modal-story">
    <div class="modal-dialog">
        <%- head('Nuevo estado') %>
        <form class="stack" id="storyForm">
            <label class="story-drop" id="storyDrop">
                <input type="file" name="media" id="storyFile" accept="image/*" required>
                <img id="storyPreview" alt="" hidden>
                <span id="storyDropHint"><%- icon('image') %>Elige una foto</span>
            </label>
            <div class="field">
                <label class="label" for="storyCaptionInput">Texto (opcional)</label>
                <input class="input" id="storyCaptionInput" name="caption" maxlength="200" placeholder="Escribe algo…">
            </div>
            <p class="muted small">Tus contactos podrán verlo durante 24 horas.</p>
            <button class="btn btn-primary btn-block" type="submit">Publicar estado</button>
        </form>
    </div>
</div>

<!-- Quién vio mi estado -->
<div class="modal" id="modal-viewers">
    <div class="modal-dialog">
        <%- head('Visto por') %>
        <ul class="user-list" id="viewersList"></ul>
    </div>
</div>

<!-- Reenviar mensaje -->
<div class="modal" id="modal-forward">
    <div class="modal-dialog forward-dialog">
        <%- head('Reenviar mensaje') %>
        <div class="forward-preview" id="forwardPreview"></div>
        <label class="search search-modal">
            <%- icon('search', 'icon-sm') %>
            <input type="search" id="forwardSearch" placeholder="Buscar chats" autocomplete="off">
        </label>
        <ul class="pick-list" id="forwardList"></ul>
        <div class="forward-foot">
            <div class="pick-chips" id="forwardChosen"></div>
            <button class="btn btn-primary btn-block" id="forwardSend" disabled><%- icon('forward') %><span id="forwardLabel">Elige hasta 5 chats</span></button>
        </div>
    </div>
</div>

<!-- Mensajes destacados -->
<div class="modal" id="modal-starred">
    <div class="modal-dialog is-wide">
        <%- head('Mensajes destacados <span class="muted" id="starredCount"></span>') %>
        <ul class="starred-list" id="starredList"></ul>
    </div>
</div>

<!-- Buscador rápido (Ctrl + K) -->
<div class="modal quick-modal" id="modal-quick">
    <div class="modal-dialog quick-dialog" role="dialog" aria-label="Buscador rápido">
        <label class="quick-search">
            <%- icon('search') %>
            <input type="search" id="quickInput" placeholder="Ir a un chat o acción…" autocomplete="off" role="combobox" aria-controls="quickList" aria-expanded="true">
            <kbd>Esc</kbd>
        </label>
        <ul class="quick-list" id="quickList" role="listbox"></ul>
        <p class="quick-foot muted"><kbd>↑</kbd><kbd>↓</kbd> moverse <kbd>Enter</kbd> abrir <kbd>Ctrl</kbd><kbd>/</kbd> ver atajos</p>
    </div>
</div>

<!-- Atajos de teclado -->
<div class="modal" id="modal-shortcuts">
    <div class="modal-dialog">
        <%- head('Atajos de teclado') %>
        <dl class="shortcuts" id="shortcutsList"></dl>
    </div>
</div>

<!-- Eliminar mensajes: para mí o para todos -->
<div class="modal" id="modal-delete-msgs">
    <div class="modal-dialog confirm">
        <span class="confirm-icon"><%- icon('trash') %></span>
        <h2 id="deleteMsgsTitle">¿Eliminar mensaje?</h2>
        <p class="muted" id="deleteMsgsText"></p>
        <div class="choice-actions">
            <button class="btn btn-danger btn-block" data-delete-choice="all" id="deleteForAll">Eliminar para todos</button>
            <button class="btn btn-ghost btn-block" data-delete-choice="me">Eliminar para mí</button>
            <button class="btn btn-ghost btn-block" data-close>Cancelar</button>
        </div>
    </div>
</div>

<!-- Info del mensaje -->
<div class="modal" id="modal-msg-info">
    <div class="modal-dialog">
        <%- head('Info. del mensaje') %>
        <div class="msg-info-preview" id="msgInfoPreview"></div>
        <div class="msg-info-body" id="msgInfoBody"></div>
    </div>
</div>

<!-- Mensajes temporales -->
<div class="modal" id="modal-disappearing">
    <div class="modal-dialog">
        <%- head('Mensajes temporales') %>
        <div class="disappear-hero">
            <span><%- icon('timer') %></span>
            <p class="muted">Los mensajes nuevos desaparecerán del chat para todos después del tiempo elegido. Los anteriores no cambian.</p>
        </div>
        <div class="radio-list" id="disappearOptions" role="radiogroup" aria-label="Duración"></div>
    </div>
</div>

<!-- Programar un mensaje -->
<div class="modal" id="modal-schedule">
    <div class="modal-dialog">
        <%- head('Programar mensaje') %>
        <form class="stack" id="scheduleForm">
            <div class="field">
                <label class="label" for="scheduleText">Mensaje</label>
                <textarea class="input" id="scheduleText" rows="3" maxlength="4000" placeholder="Escribe el mensaje…" required></textarea>
            </div>
            <div class="field">
                <span class="label">¿Cuándo?</span>
                <div class="quick-times" id="scheduleQuick"></div>
            </div>
            <div class="field">
                <label class="label" for="scheduleAt">Fecha y hora</label>
                <input class="input" id="scheduleAt" type="datetime-local" required>
            </div>
            <p class="muted small" id="scheduleHint"></p>
            <button class="btn btn-primary btn-block" type="submit"><%- icon('calendar-clock') %><span>Programar</span></button>
        </form>
    </div>
</div>

<!-- Mensajes programados del chat -->
<div class="modal" id="modal-scheduled">
    <div class="modal-dialog">
        <%- head('Mensajes programados') %>
        <ul class="scheduled-list" id="scheduledList"></ul>
        <button class="btn btn-ghost btn-block" data-action="new-schedule"><%- icon('plus') %>Programar otro</button>
    </div>
</div>

<!-- Cambiar contraseña -->
<div class="modal" id="modal-password">
    <div class="modal-dialog password-dialog">
        <%- head('Cambiar contraseña') %>
        <div class="password-hero">
            <span><%- icon('lock') %></span>
            <p class="muted">Usa una contraseña que no uses en otros sitios. Te pediremos la actual para confirmar que eres tú.</p>
        </div>
        <form class="stack" id="passwordForm" novalidate>
            <input type="text" name="username" autocomplete="username" value="<%= user.username %>" hidden>
            <div class="field">
                <label class="label" for="pwCurrent">Contraseña actual</label>
                <div class="input-group">
                    <input class="input" type="password" id="pwCurrent" name="current" autocomplete="current-password" required>
                    <button type="button" class="icon-btn pw-toggle" data-pw-toggle="pwCurrent" aria-label="Mostrar contraseña"><%- icon('eye') %></button>
                </div>
                <span class="field-error" data-pw-error="current"></span>
            </div>
            <div class="field">
                <label class="label" for="pwNext">Nueva contraseña</label>
                <div class="input-group">
                    <input class="input" type="password" id="pwNext" name="next" autocomplete="new-password" minlength="6" required>
                    <button type="button" class="icon-btn pw-toggle" data-pw-toggle="pwNext" aria-label="Mostrar contraseña"><%- icon('eye') %></button>
                </div>
                <div class="pw-strength" id="pwStrength" data-level="0" aria-hidden="true"><i></i><i></i><i></i></div>
                <small class="field-note" id="pwStrengthLabel">Mínimo 6 caracteres.</small>
                <span class="field-error" data-pw-error="next"></span>
            </div>
            <div class="field">
                <label class="label" for="pwConfirm">Repite la nueva contraseña</label>
                <div class="input-group">
                    <input class="input" type="password" id="pwConfirm" name="confirm" autocomplete="new-password" required>
                    <span class="pw-match" id="pwMatch" aria-hidden="true"></span>
                </div>
                <span class="field-error" data-pw-error="confirm"></span>
            </div>
            <label class="check-row">
                <input type="checkbox" id="pwLogoutOthers" checked>
                <span><strong>Cerrar sesión en mis otros dispositivos</strong><small>Recomendado si crees que alguien conoce tu contraseña</small></span>
            </label>
            <button class="btn btn-primary btn-block" type="submit" id="pwSubmit" disabled><%- icon('check') %><span>Cambiar contraseña</span></button>
        </form>
    </div>
</div>

<!-- Conocer: asistente del perfil de citas -->
<div class="modal" id="modal-dating">
    <div class="modal-dialog dz-wizard">
        <div class="modal-head">
            <h2 id="dzWizTitle">Tu perfil de citas</h2>
            <button class="icon-btn" data-close aria-label="Cerrar"><%- icon('x') %></button>
        </div>
        <ol class="dz-progress" id="dzProgress" aria-label="Pasos">
            <li data-goto="1"><i></i><span>Fotos</span></li>
            <li data-goto="2"><i></i><span>Sobre ti</span></li>
            <li data-goto="3"><i></i><span>Gustos</span></li>
            <li data-goto="4"><i></i><span>Seguridad</span></li>
        </ol>
        <form id="dzForm" novalidate>
            <!-- 1. Fotos -->
            <section class="dz-step is-active" data-step="1">
                <h3>Tus fotos <span class="dz-count" id="dzPhotoCount">0/6</span></h3>
                <p class="muted">La primera es la principal. Toca otra foto para hacerla principal.</p>
                <div class="dz-photos" id="dzPhotos"></div>
                <ul class="dz-tips" aria-label="Consejos">
                    <li><%- icon('sun', 'icon-sm') %>Buena luz</li>
                    <li><%- icon('smile-face', 'icon-sm') %>Que se vea tu cara</li>
                    <li><%- icon('user-focus', 'icon-sm') %>Solo tú en la principal</li>
                </ul>
                <input type="file" id="dzPhotoInput" accept="image/*" multiple hidden>
            </section>
            <!-- 2. Sobre ti -->
            <section class="dz-step" data-step="2">
                <h3>Sobre ti</h3>
                <div class="field-row">
                    <div class="field">
                        <label class="label" for="dzBirth">Fecha de nacimiento</label>
                        <input class="input" type="date" id="dzBirth" required>
                        <small class="field-note" id="dzBirthNote">Debes ser mayor de 18. Solo se muestra tu edad.</small>
                    </div>
                    <div class="field">
                        <label class="label" for="dzProvince">Provincia</label>
                        <select class="input" id="dzProvince" required></select>
                    </div>
                </div>
                <div class="field">
                    <span class="label">Soy</span>
                    <div class="dz-choice" data-name="gender">
                        <button type="button" data-value="woman">Mujer</button>
                        <button type="button" data-value="man">Hombre</button>
                        <button type="button" data-value="nonbinary">No binario</button>
                    </div>
                </div>
                <div class="field">
                    <span class="label">Quiero conocer a</span>
                    <div class="dz-choice" data-name="interestedIn">
                        <button type="button" data-value="women">Mujeres</button>
                        <button type="button" data-value="men">Hombres</button>
                        <button type="button" data-value="everyone">Todos</button>
                    </div>
                </div>
                <div class="field">
                    <span class="label">Busco</span>
                    <div class="dz-choice" data-name="lookingFor">
                        <button type="button" data-value="pareja"><%- icon('heart', 'icon-sm') %>Pareja</button>
                        <button type="button" data-value="algo_casual"><%- icon('martini', 'icon-sm') %>Algo casual</button>
                        <button type="button" data-value="amistad"><%- icon('handshake', 'icon-sm') %>Amistad</button>
                        <button type="button" data-value="no_se"><%- icon('help', 'icon-sm') %>Aún no sé</button>
                    </div>
                </div>
                <div class="field">
                    <label class="label" for="dzAbout">Sobre mí <span class="muted" id="dzAboutCount">0/300</span></label>
                    <textarea class="input" id="dzAbout" rows="3" maxlength="300" placeholder="Algo corto que te describa…"></textarea>
                </div>
            </section>
            <!-- 3. Intereses y preguntas -->
            <section class="dz-step" data-step="3">
                <h3>Lo que te gusta <span class="dz-count" id="dzInterestCount">0/8</span></h3>
                <p class="muted" id="dzInterestHint">Elige entre 3 y 8. Te mostraremos la afinidad con cada persona.</p>
                <div class="dz-interests" id="dzInterests"></div>
                <h3 class="dz-sub">Responde hasta 3 preguntas</h3>
                <div class="dz-prompts" id="dzPrompts"></div>
            </section>
            <!-- 4. Verificación y normas -->
            <section class="dz-step" data-step="4">
                <h3>Seguridad</h3>
                <div class="dz-verify" id="dzVerify">
                    <span class="dz-verify-ico"><%- icon('shield-check') %></span>
                    <div>
                        <strong>Verifica tu perfil</strong>
                        <p class="muted dz-verify-text">Toma una selfie haciendo el gesto de paz <%- icon('victory', 'icon-sm') %>. Los perfiles verificados reciben más matches.</p>
                        <input type="file" id="dzSelfie" accept="image/*" capture="user" hidden>
                        <button type="button" class="btn btn-ghost btn-sm" id="dzSelfieBtn"><%- icon('camera', 'icon-sm') %>Tomar selfie</button>
                    </div>
                </div>
                <ul class="dz-rules">
                    <li><%- icon('check', 'icon-sm') %>Trata a todas las personas con respeto.</li>
                    <li><%- icon('check', 'icon-sm') %>Solo mayores de 18 años.</li>
                    <li><%- icon('check', 'icon-sm') %>No compartas datos sensibles (dirección, cuentas, contraseñas).</li>
                    <li><%- icon('check', 'icon-sm') %>Para la primera cita, elige un lugar público y avisa a alguien.</li>
                </ul>
                <label class="check-row">
                    <input type="checkbox" id="dzPaused">
                    <span><strong>Pausar mi perfil</strong><small>No aparecerás en «Conocer», pero conservas tus matches</small></span>
                </label>
            </section>
            <footer class="dz-wiz-foot">
                <div class="dz-alert" id="dzAlert" role="alert" hidden></div>
                <button type="button" class="btn btn-ghost" id="dzBack">Atrás</button>
                <button type="button" class="btn btn-primary" id="dzNext">Siguiente</button>
            </footer>
        </form>
    </div>
</div>

<!-- Conocer: filtros -->
<div class="modal" id="modal-dating-filters">
    <div class="modal-dialog">
        <%- head('Filtros') %>
        <form class="stack" id="dzFilters">
            <div class="field">
                <span class="label">Edad <b id="dzAgeLabel">21–40</b></span>
                <div class="dz-range">
                    <input type="range" id="dzAgeMin" min="18" max="99" step="1">
                    <input type="range" id="dzAgeMax" min="18" max="99" step="1">
                </div>
            </div>
            <div class="field">
                <span class="label">Distancia máxima <b id="dzKmLabel">200 km</b></span>
                <input type="range" id="dzKm" min="10" max="500" step="10" class="dz-slider">
            </div>
            <label class="check-row"><input type="checkbox" id="dzOnlyVerified"><span><strong>Solo perfiles verificados</strong><small>Con la insignia azul</small></span></label>
            <label class="check-row"><input type="checkbox" id="dzOnlyCommon"><span><strong>Solo con intereses en común</strong><small>Al menos uno compartido</small></span></label>
            <button class="btn btn-primary btn-block" type="submit">Aplicar filtros</button>
        </form>
    </div>
</div>

<!-- Conocer: ¡Es un match! -->
<div class="modal dz-match-modal" id="modal-match">
    <div class="dz-match">
        <div class="dz-confetti" aria-hidden="true"></div>
        <p class="dz-match-kicker">¡Es un match!</p>
        <h2 id="dzMatchTitle">Tú y Daniela se gustan</h2>
        <div class="dz-match-pics">
            <img id="dzMatchMe" src="" alt="">
            <span class="dz-match-heart"><%- icon('heart-fill') %></span>
            <img id="dzMatchThem" src="" alt="">
        </div>
        <p class="dz-match-common" id="dzMatchCommon"></p>
        <button class="btn btn-light btn-block" id="dzMatchChat"><%- icon('chat') %>Enviar un mensaje</button>
        <button class="btn btn-outline-light btn-block" data-close>Seguir descubriendo</button>
        <p class="dz-match-tip"><%- icon('shield-check', 'icon-sm') %> Consejo: conózcanse primero por chat o videollamada.</p>
    </div>
</div>

<!-- Conocer: reportar -->
<div class="modal" id="modal-report">
    <div class="modal-dialog">
        <%- head('Reportar perfil') %>
        <form class="stack" id="reportForm">
            <p class="muted">Gracias por ayudarnos. La persona no sabrá que la reportaste y quedará bloqueada para ti.</p>
            <div class="radio-list" id="reportReasons"></div>
            <div class="field">
                <label class="label" for="reportDetails">Detalles (opcional)</label>
                <textarea class="input" id="reportDetails" rows="2" maxlength="300"></textarea>
            </div>
            <button class="btn btn-danger btn-block" type="submit" id="reportSubmit" disabled><%- icon('flag') %>Reportar y bloquear</button>
        </form>
    </div>
</div>

<!-- Conocer: proponer una cita -->
<div class="modal" id="modal-propose-date">
    <div class="modal-dialog">
        <%- head('Proponer una cita') %>
        <form class="stack" id="proposeForm" novalidate>
            <div class="dz-choice" data-name="dateKind">
                <button type="button" data-value="video" class="is-selected"><%- icon('video', 'icon-sm') %>Videollamada</button>
                <button type="button" data-value="place"><%- icon('map-pin', 'icon-sm') %>En persona</button>
            </div>
            <div class="field" id="proposePlaceField" hidden>
                <label class="label" for="proposePlace">Lugar</label>
                <input class="input" id="proposePlace" maxlength="80" placeholder="Ej. Café en Barrio Escalante">
            </div>
            <div class="field">
                <label class="label" for="proposeWhen">Día y hora</label>
                <input class="input" type="datetime-local" id="proposeWhen" required>
            </div>
            <p class="muted small"><%- icon('shield-check', 'icon-sm') %> Para la primera cita en persona, elige un lugar público.</p>
            <div class="dz-alert" id="proposeAlert" role="alert" hidden></div>
            <button class="btn btn-primary btn-block" type="submit"><%- icon('calendar-heart') %>Enviar propuesta</button>
        </form>
    </div>
</div>

<!-- Instalar Yabla (instrucciones para iPhone y otros navegadores) -->
<div class="modal" id="modal-install">
    <div class="modal-dialog install-dialog">
        <%- head('Instalar Yabla') %>
        <div class="install-hero">
            <img src="/assets/images/pwa/icon-192.png" alt="" width="72" height="72">
            <p>Instálala en tu pantalla de inicio para usarla como una app: a pantalla completa y con <strong>notificaciones con sonido</strong>.</p>
        </div>
        <ol class="install-steps" id="installIos">
            <li><span class="install-n">1</span><span>En Safari, toca <strong>Compartir</strong> <span class="install-ico"><%- icon('share', 'icon-sm') %></span> en la barra de abajo.</span></li>
            <li><span class="install-n">2</span><span>Elige <strong>Agregar a inicio</strong> <span class="install-ico"><%- icon('square-plus', 'icon-sm') %></span> y toca <strong>Agregar</strong>.</span></li>
            <li><span class="install-n">3</span><span>Abre Yabla desde su icono y activa las notificaciones en <strong>Ajustes</strong>.</span></li>
        </ol>
        <ol class="install-steps" id="installOther" hidden>
            <li><span class="install-n">1</span><span>Abre el menú del navegador <span class="install-ico"><%- icon('more', 'icon-sm') %></span>.</span></li>
            <li><span class="install-n">2</span><span>Elige <strong>Instalar app</strong> o <strong>Agregar a la pantalla de inicio</strong>.</span></li>
            <li><span class="install-n">3</span><span>Abre Yabla desde su icono. Las notificaciones se activan en <strong>Ajustes</strong>.</span></li>
        </ol>
        <p class="muted small install-note"><%- icon('info', 'icon-sm') %>En iPhone hace falta iOS 16.4 o posterior.</p>
    </div>
</div>

<!-- Confirmación genérica -->
<div class="modal" id="modal-confirm">
    <div class="modal-dialog confirm">
        <span class="confirm-icon"><%- icon('trash') %></span>
        <h2 id="confirmTitle"></h2>
        <p class="muted" id="confirmText"></p>
        <div class="confirm-actions">
            <button class="btn btn-ghost" data-close>Cancelar</button>
            <button class="btn btn-danger" id="confirmOk">Aceptar</button>
        </div>
    </div>
</div>

<!-- Cerrar sesión -->
<div class="modal" id="modal-logout">
    <div class="modal-dialog confirm">
        <span class="confirm-icon"><%- icon('logout') %></span>
        <h2>¿Cerrar sesión?</h2>
        <p class="muted">Tendrás que volver a iniciar sesión para ver tus chats.</p>
        <form class="confirm-actions" method="post" action="/logout">
            <button type="button" class="btn btn-ghost" data-close>Cancelar</button>
            <button type="submit" class="btn btn-danger">Cerrar sesión</button>
        </form>
    </div>
</div>
